# =====================================================================
#  Caddyfile snippet for agent-stack
#  Drop it into /etc/caddy/Caddyfile (or include it via `import`).
#  Replace your-domain.tld with your real domain whose A record points to the VPS.
# =====================================================================

your-domain.tld {
    encode zstd gzip

    # Proxy (Express on :3001), exposed under /_kp/*
    # handle_path strips /_kp before forwarding.
    handle_path /_kp/* {
        reverse_proxy localhost:3001 {
            flush_interval -1
        }
    }

    # Optional — static sites built by the agent: /sites/<slug>/
    handle_path /sites/* {
        root * /opt/agent-sites
        encode zstd gzip
        file_server
        try_files {path} {path}/index.html /index.html
        @img path *.png *.jpg *.jpeg *.webp *.gif *.svg *.ico *.woff2 *.woff *.css *.js
        header @img Cache-Control "public, max-age=86400, immutable"
    }

    # Everything else — Next.js UI (port 3002)
    handle {
        encode zstd gzip
        reverse_proxy localhost:3002 {
            flush_interval -1
        }
    }

    log {
        output file /var/log/caddy/agent-stack.log
        format json
    }
}
