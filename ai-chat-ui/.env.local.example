# ====================================================================
#  ai-chat-ui — Next.js frontend
#  Copy to .env.local. Gitignored.
# ====================================================================

# Where the frontend reaches the proxy (kimi-mcp-proxy).
# Same machine, local:
NEXT_PUBLIC_API_URL=http://localhost:3001
# External domain with HTTPS via Caddy/Nginx:
# NEXT_PUBLIC_API_URL=https://your-domain.tld/_kp

# Basic auth for the UI itself (middleware checks login/password).
# Without it, anyone can see your chat. Set them.
AUTH_USER=admin
AUTH_PASSWORD=pick-a-long-password
AUTH_SECRET=random-cookie-secret-min-32-chars

# Next.js port (default 3002, matches the Caddyfile).
PORT=3002
NODE_ENV=production

# ====================================================================
#  Media Studio (optional) — /media page with YouTube channel tools
# ====================================================================

# Your channel id — the UC... part of youtube.com/channel/UC...
# Leave empty to keep the /media page dormant.
NEXT_PUBLIC_YT_CHANNEL_ID=
# Optional: your site, used as the CTA in generated ideas/scripts.
NEXT_PUBLIC_BRAND_SITE=
# Channel name/niche/audience for generation prompts:
# edit CHANNEL_PROFILE in app/lib/mediaStudio.ts

# ====================================================================
#  OAuth login (optional, recommended over basic auth)
# ====================================================================

# Public HTTPS URL where the UI is served. Needed for the OAuth callback.
# Must match what you registered in the GitHub/Google consoles.
OAUTH_REDIRECT_BASE=https://your-domain.tld

# Email whitelist: only these users get in, even after a successful OAuth.
# Set it, or anyone with a GitHub/Google account can log in.
ALLOWED_EMAILS=you@example.com

# ---- GitHub OAuth App ----
# Register: https://github.com/settings/developers -> "New OAuth App"
# Authorization callback URL: https://your-domain.tld/api/auth/oauth/github/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ---- Google OAuth Client ----
# Register: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.tld/api/auth/oauth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Shared secret the UI uses to call proxy /v1/auth/device/approve.
# Must match PROXY_API_KEY in kimi-mcp-proxy/.env.
PROXY_API_KEY=must-match-PROXY_API_KEY-in-proxy-.env
