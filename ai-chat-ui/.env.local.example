# ====================================================================
#  ai-chat-ui — Next.js фронт
#  Скопируй в .env.local. В git не попадает (см. .gitignore).
# ====================================================================

# Куда фронт стучится за API прокси (тот самый kimi-mcp-proxy).
# Локально на той же машине:
NEXT_PUBLIC_API_URL=http://localhost:3001
# С внешним доменом и HTTPS через Caddy/Nginx:
# NEXT_PUBLIC_API_URL=https://your-domain.tld/_kp

# Basic-auth на сам UI (middleware проверяет логин/пароль).
# Без них любой увидит твой чат — обязательно поставь.
AUTH_USER=admin
AUTH_PASSWORD=придумай-длинный-пароль
AUTH_SECRET=рандомный-секрет-для-кук-минимум-32-символа

# Порт Next.js (по умолчанию 3002, согласован с Caddyfile)
PORT=3002
NODE_ENV=production

# ====================================================================
#  OAuth-вход (опционально, но рекомендуется вместо basic-auth)
# ====================================================================

# Публичный URL, на котором висит UI с HTTPS — нужен для OAuth-callback.
# Должен совпадать с тем, что зарегистрировано в GitHub/Google консолях.
OAUTH_REDIRECT_BASE=https://your-domain.tld

# Email-whitelist: только эти юзеры пустятся, даже если OAuth прошёл успешно.
# ОБЯЗАТЕЛЬНО заполни, иначе любой человек с GitHub/Google залогинится.
ALLOWED_EMAILS=you@example.com

# ---- GitHub OAuth App ----
# Регистрация:  https://github.com/settings/developers → "New OAuth App"
# Authorization callback URL:  https://your-domain.tld/api/auth/oauth/github/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ---- Google OAuth Client ----
# Регистрация:  https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  https://your-domain.tld/api/auth/oauth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Shared-секрет, которым UI стучится в proxy /v1/auth/device/approve.
# Должен совпадать с PROXY_API_KEY в kimi-mcp-proxy/.env.
PROXY_API_KEY=совпадает-с-PROXY_API_KEY-в-proxy-.env
