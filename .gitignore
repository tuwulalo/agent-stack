# =========================================================
#  agent-stack — shared .gitignore
#  IMPORTANT: all secrets and keys stay HERE, they never land in the repo
# =========================================================

# ---- secrets, keys, tokens ----
.env
.env.*
!.env.example
!.env.*.example
*.env
*.env.local
*.tg_token
.tg_token
.tg_token*
*.key
*.pem
*.p12
*.pfx
*.crt
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
authorized_keys
known_hosts
secrets.json
credentials.json
service-account*.json
gcp-key*.json

# ---- personal data / chats / agent sessions ----
agent-sessions.json
agent-sessions.json.*
chat-store/
kimi-chats/
automations-runs.jsonl
automations-schedules.json
telegram-state.json

# ---- backups / temporary files ----
*.bak
*.bak.*
*~
*.swp
*.swo

# ---- node / next ----
node_modules/
.next/
out/
.cache/
.turbo/
dist/
build/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- system files ----
.DS_Store
Thumbs.db

# ---- IDE ----
.idea/
.vscode/
*.iml

# ---- Claude / agent cache (just in case) ----
.claude/projects/
.claude/sessions/
~/.claude/

# ---- logs ----
*.log
logs/
