# ====================================================================
#  kimi-mcp-proxy — конфиг провайдера
#  Скопируй в .env и заполни. .env в git НЕ попадает (см. .gitignore).
# ====================================================================

# ---- порт прокси ----
HOST=0.0.0.0
PORT=3001

# ---- активный LLM-провайдер ----
# Прокси OpenAI-compatible. Меняешь BASE_URL+API_KEY+MODEL — меняешь провайдера.
# Имя переменных оставлено как KIMI_* по историческим причинам (это просто "upstream").

# ---- 1) Moonshot / Kimi (по умолчанию) ----
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_API_KEY=sk-замени-меня
KIMI_MODEL=kimi-k2-0711-preview

# ---- 2) OpenAI / GPT ----
# KIMI_BASE_URL=https://api.openai.com/v1
# KIMI_API_KEY=sk-...
# KIMI_MODEL=gpt-4o

# ---- 3) Anthropic / Claude (через OpenAI-compat endpoint) ----
# KIMI_BASE_URL=https://api.anthropic.com/v1
# KIMI_API_KEY=sk-ant-...
# KIMI_MODEL=claude-opus-4-7

# ---- 4) Google / Gemini / Antigravity (OpenAI-compat) ----
# KIMI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# KIMI_API_KEY=AIza...
# KIMI_MODEL=gemini-2.5-pro

# ---- 5) Cerebras (то самое "Села"? — сверхбыстрый инференс) ----
# KIMI_BASE_URL=https://api.cerebras.ai/v1
# KIMI_API_KEY=csk-...
# KIMI_MODEL=llama-3.3-70b

# ---- 6) DeepSeek ----
# KIMI_BASE_URL=https://api.deepseek.com/v1
# KIMI_API_KEY=sk-...
# KIMI_MODEL=deepseek-chat

# ---- 7) OpenRouter (единая точка ко всему: Claude / Gemini / GPT / Kimi / Llama) ----
# KIMI_BASE_URL=https://openrouter.ai/api/v1
# KIMI_API_KEY=sk-or-...
# KIMI_MODEL=anthropic/claude-opus-4

# ---- 8) xAI / Grok ----
# KIMI_BASE_URL=https://api.x.ai/v1
# KIMI_API_KEY=xai-...
# KIMI_MODEL=grok-4

# ---- 9) Mistral ----
# KIMI_BASE_URL=https://api.mistral.ai/v1
# KIMI_API_KEY=...
# KIMI_MODEL=mistral-large-latest

# ---- защита прокси (Bearer-токен для входящих запросов) ----
# Любой свой длинный рандом. Без него любой в интернете будет тратить твою квоту.
PROXY_API_KEY=поменяй-меня-на-длинный-рандом

# ---- лимиты / таймауты ----
REQUEST_TIMEOUT_MS=120000
AUTOMATION_TIMEOUT_MS=1800000
DELEGATE_TIMEOUT_MS=900000
AGENT_TIMEOUT_MS=600000
MAX_REQUEST_BYTES=50mb

# ---- воркеры (опционально) ----
WORKER_SANDBOX=docker
WORKER_MEM_MAX=2g
WORKER_MEM_SWAP=2g

# ---- Telegram-бот (опционально) ----
# Создай через @BotFather. Если не нужно — оставь пустым.
TELEGRAM_BOT_TOKEN=

# ---- Claude Code как backend для агентских воркеров (опционально) ----
# Используется, если у тебя есть подписка Claude Code (claude CLI установлен).
# CLAUDE_BIN=/usr/local/bin/claude
