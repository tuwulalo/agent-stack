# ====================================================================
#  kimi-mcp-proxy — provider config
#  Copy to .env and fill in. .env is gitignored.
# ====================================================================

# ---- proxy port ----
HOST=0.0.0.0
PORT=3001

# ---- active LLM provider ----
# The proxy is OpenAI-compatible. Swap BASE_URL + API_KEY + MODEL to switch
# providers. Variable names stay KIMI_* for historical reasons (just "upstream").

# ---- 1) Moonshot / Kimi (default) ----
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_API_KEY=sk-replace-me
KIMI_MODEL=kimi-k2-0711-preview

# ---- 2) OpenAI / GPT ----
# KIMI_BASE_URL=https://api.openai.com/v1
# KIMI_API_KEY=sk-...
# KIMI_MODEL=gpt-4o

# ---- 3) Anthropic / Claude (via OpenAI-compatible endpoint) ----
# KIMI_BASE_URL=https://api.anthropic.com/v1
# KIMI_API_KEY=sk-ant-...
# KIMI_MODEL=claude-opus-4-7

# ---- 4) Google / Gemini (OpenAI-compatible) ----
# KIMI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# KIMI_API_KEY=AIza...
# KIMI_MODEL=gemini-2.5-pro

# ---- 5) Cerebras (very fast inference) ----
# KIMI_BASE_URL=https://api.cerebras.ai/v1
# KIMI_API_KEY=csk-...
# KIMI_MODEL=llama-3.3-70b

# ---- 6) DeepSeek ----
# KIMI_BASE_URL=https://api.deepseek.com/v1
# KIMI_API_KEY=sk-...
# KIMI_MODEL=deepseek-chat

# ---- 7) OpenRouter (one endpoint to everything: Claude / Gemini / GPT / Kimi / Llama) ----
# KIMI_BASE_URL=https://openrouter.ai/api/v1
# KIMI_API_KEY=sk-or-...
# KIMI_MODEL=anthropic/claude-opus-4

# ---- 8) xAI / Grok ----
# KIMI_BASE_URL=https://api.x.ai/v1
# KIMI_API_KEY=xai-...
# KIMI_MODEL=grok-4

# ---- 9) Mistral ----
# KIMI_BASE_URL=https://api.mistral.ai/v1
# KIMI_API_KEY=...
# KIMI_MODEL=mistral-large-latest

# ---- proxy protection (Bearer token for incoming requests) ----
# Any long random string. Without it, anyone on the internet can spend your quota.
PROXY_API_KEY=replace-with-a-long-random-string

# ---- JWT secret for device-flow tokens ----
# Signs the access tokens that desktop CLIs get via OAuth Device Flow.
# Min 32 chars. Changing it invalidates every previously issued token.
JWT_SECRET=replace-with-32+-random-chars

# ---- public UI URL (device flow needs it for verification_uri) ----
# Where the CLI sends the user to log in (same base as the OAuth callbacks).
PUBLIC_BASE=https://your-domain.tld

# ---- limits / timeouts ----
REQUEST_TIMEOUT_MS=120000
AUTOMATION_TIMEOUT_MS=1800000
DELEGATE_TIMEOUT_MS=900000
AGENT_TIMEOUT_MS=600000
MAX_REQUEST_BYTES=50mb

# ---- workers (optional) ----
WORKER_SANDBOX=docker
WORKER_MEM_MAX=2g
WORKER_MEM_SWAP=2g

# ---- Telegram bot (optional) ----
# Create one via @BotFather. Leave empty if not needed.
TELEGRAM_BOT_TOKEN=

# ---- Claude Code as the backend for agent workers (optional) ----
# Used if you have a Claude Code subscription (the claude CLI installed).
# CLAUDE_BIN=/usr/local/bin/claude

# ====================================================================
#  Model Arena (optional) — /arena page, compare providers side by side
# ====================================================================
# Each provider is reached over an OpenAI-compatible /chat/completions
# endpoint. A provider only shows up in the arena once its key is set.
# Kimi reuses the proxy's own upstream above — no extra key needed.

# Claude via Anthropic's OpenAI-compatible endpoint.
ANTHROPIC_API_KEY=
# ARENA_CLAUDE_MODEL=claude-opus-4-8      # or claude-sonnet-4-6 / claude-haiku-4-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# GLM via Zhipu's OpenAI-compatible endpoint (or route through OpenRouter).
ZHIPU_API_KEY=
# ARENA_GLM_MODEL=glm-4.6
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Override the Kimi column if you want it different from the proxy default.
# ARENA_KIMI_MODEL=kimi-for-coding
